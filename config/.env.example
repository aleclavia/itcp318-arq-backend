# Copy this file to  backend/config/.env  and fill in the blanks
PORT = 4001
NODE_ENV = DEVELOPMENT
CLIENT_URL = http://localhost:5173

# MongoDB (Atlas or local)
DB_URI = "mongodb+srv://username:password@cluster0.xxxxx.mongodb.net/arqane?retryWrites=true&w=majority"

# Cloudinary  (Dashboard -> API Keys)
CLOUDINARY_CLOUD_NAME =
CLOUDINARY_API_KEY =
CLOUDINARY_API_SECRET =

# JWT / cookie
JWT_SECRET = change_this_to_a_long_random_string
JWT_EXPIRES_TIME = 7d
COOKIE_EXPIRES_TIME = 7

# Mailtrap (or any SMTP) - used for password reset + order status emails with PDF receipt
SMTP_HOST = sandbox.smtp.mailtrap.io
SMTP_PORT = 2525
SMTP_EMAIL =
SMTP_PASSWORD =
SMTP_FROM_EMAIL = noreply@arqanearqade.com
SMTP_FROM_NAME = ARQANE ARQADE

# Firebase project id (Google login) - Firebase console -> Project settings -> General
FIREBASE_PROJECT_ID =

# Behaviour switches
# true  = only customers whose order was Delivered may review that product
# false = any customer who has ordered it may review (handy while testing)
REVIEW_REQUIRES_DELIVERED = true
# IANA timezone used when grouping sales by day/month
TIMEZONE = Asia/Manila
# Optional: extra words for the bad-words filter, comma separated
EXTRA_BAD_WORDS =
